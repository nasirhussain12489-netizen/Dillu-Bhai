rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSuperAdmin() {
      return isVerified() && (
        request.auth.token.email == 'nasirhussain12489@gmail.com' ||
        request.auth.token.email == 'gausiyamadarsa92@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidRole(role) {
      return role in ['Super Admin', 'Admin', 'Teacher', 'Student', 'Parent'];
    }

    function isValidPortalUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'studentId', 'name', 'email', 'role', 'updatedAt']) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             (!('studentId' in data) || (data.studentId is string && data.studentId.size() <= 64)) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             isValidRole(data.role) &&
             data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    function isValidPortalStateDoc(data) {
      return data.keys().hasAll(['ownerId', 'payloadJson', 'updatedAt']) &&
             data.keys().hasOnly(['ownerId', 'payloadJson', 'updatedAt']) &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.payloadJson is string && data.payloadJson.size() >= 2 && data.payloadJson.size() <= 900000 &&
             data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin() && isValidId(adminId);
    }

    match /portal_users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isSuperAdmin());
      allow create: if isVerified() &&
                    isValidId(userId) &&
                    isValidPortalUser(incoming()) &&
                    incoming().uid == userId &&
                    (
                      isSuperAdmin() ||
                      (request.auth.uid == userId && incoming().role == 'Student')
                    );
      allow update: if isVerified() &&
                    isValidId(userId) &&
                    isValidPortalUser(incoming()) &&
                    incoming().uid == existing().uid &&
                    (
                      isSuperAdmin() ||
                      (
                        request.auth.uid == userId &&
                        incoming().role == existing().role &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
                      )
                    );
      allow delete: if isSuperAdmin() && isValidId(userId);
    }

    match /portal_state/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && (existing().ownerId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isSuperAdmin());
      allow create: if isVerified() &&
                    isValidId(docId) &&
                    isValidPortalStateDoc(incoming()) &&
                    incoming().ownerId == request.auth.uid;
      allow update: if isVerified() &&
                    isValidId(docId) &&
                    isValidPortalStateDoc(incoming()) &&
                    incoming().ownerId == request.auth.uid &&
                    (
                      isSuperAdmin() ||
                      (
                        existing().ownerId == request.auth.uid &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['payloadJson', 'updatedAt'])
                      )
                    );
      allow delete: if isSuperAdmin() && isValidId(docId);
    }
  }
}
